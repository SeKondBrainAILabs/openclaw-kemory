{
  "name": "openclaw-kemory",
  "version": "0.1.0",
  "description": "Kemory memory plugin for OpenClaw: recall before each turn, capture after it.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.1"
    },
    "install": {
      "minHostVersion": ">=2026.10.1"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.1"
  },
  "dependencies": {
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "openclaw": "2026.10.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
